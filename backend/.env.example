DJANGO_DEBUG=true
# Ejecuta python setup_local.py para generar una clave única; no uses una clave de ejemplo.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DB_ENGINE=sqlite
# Para PostgreSQL, cambia DB_ENGINE a postgres y completa:
# DB_NAME=morgillo
# DB_USER=morgillo
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_SSLMODE=prefer
# En producción usa DEBUG=false, HTTPS y un volumen persistente:
# MEDIA_ROOT=/var/lib/morgillo/media
# DJANGO_TRUST_PROXY=false
