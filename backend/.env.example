DJANGO_DEBUG=true
# Ejecuta python setup_local.py para generar una clave única; no uses una clave de ejemplo.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DB_ENGINE=sqlite
# Render proporciona DATABASE_URL. Si está definida, tiene prioridad sobre DB_*.
# DATABASE_URL=postgresql://usuario:clave@servidor:5432/morgillo?sslmode=require
# Para PostgreSQL, cambia DB_ENGINE a postgres y completa:
# DB_NAME=morgillo
# DB_USER=morgillo
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_SSLMODE=prefer
# DB_CONN_MAX_AGE=60
# DB_CONNECT_TIMEOUT=10
# DB_DISABLE_SERVER_SIDE_CURSORS=false
# En producción usa DEBUG=false, HTTPS y un volumen persistente:
# MEDIA_ROOT=/var/lib/morgillo/media
# DJANGO_TRUST_PROXY=false
