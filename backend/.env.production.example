# Configurar estos valores en Render. Este archivo no contiene credenciales reales.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
# Render agrega su dominio automáticamente; agregar aquí los dominios propios.
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY=true
DJANGO_SECURE_SSL_REDIRECT=true
DB_ENGINE=postgres
# Dentro de Render usar la Internal Database URL; desde la PC usar la External.
DATABASE_URL=
DB_SSLMODE=require
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=10
# Prueba gratuita: los archivos se guardan en PostgreSQL junto a sus referencias.
# En Render este modo se activa automáticamente si no se define MEDIA_STORAGE.
MEDIA_STORAGE=database
# Para un servicio con disco persistente: MEDIA_STORAGE=filesystem y MEDIA_ROOT.
# MEDIA_ROOT=/var/data/morgillo/media
